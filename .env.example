# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# Notificações push (gratuitas). Gere com: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seu-email@exemplo.com

# Ping diário que impede o Supabase Free de pausar (Vercel Cron envia este segredo).
# Gere com: npx -y uuid  (ou qualquer texto longo e aleatório)
CRON_SECRET=
